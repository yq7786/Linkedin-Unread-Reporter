{
  "name": "linkedin-unread-reporter",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only LinkedIn unread conversation reports delivered to Slack.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "check": "node --check src/*.js && node test/run-tests.js",
    "configure": "node src/cli.js configure",
    "login": "node src/cli.js login",
    "scan": "node src/cli.js scan",
    "slack-test": "node src/cli.js slack-test",
    "report": "node src/cli.js scheduled-report"
  },
  "dependencies": {
    "playwright": "1.55.1"
  },
  "license": "MIT"
}
